# Environment Configuration for Techbit Backend

# Server Configuration
PORT=3002
NODE_ENV=development

# ATProto Configuration (for future integration)
BSKY_USERNAME=your_username
BSKY_PASSWORD=your_password
BSKY_SERVICE=https://bsky.social

# GitHub API Configuration (for future integration)
GITHUB_TOKEN=your_github_token
GITHUB_API_URL=https://api.github.com

# Neo4j Configuration (for future integration)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# IPFS Configuration (for future integration)
IPFS_HOST=localhost
IPFS_PORT=5001
IPFS_PROTOCOL=http

# PDS Configuration
PDS_NODE_ID=pds-node-001
PDS_STORAGE_PATH=./data/storage

# Scoring Configuration
NOVELTY_BASE_SCORE=0.5
IMPACT_BASE_SCORE=0.3
MAX_TRENDING_TAGS=10

# Feed Configuration
DEFAULT_FEED_LIMIT=10
MAX_FEED_LIMIT=100

# Logging
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true
